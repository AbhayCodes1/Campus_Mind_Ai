{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --input-type=module -e \"process.env.NODE_ENV='development'; process.env.PORT ??= '8080'; const { spawnSync } = await import('node:child_process'); const run = (cmd, args) => { const result = spawnSync(cmd, args, { stdio: 'inherit', shell: true, env: { ...process.env, NODE_ENV: 'development', PORT: process.env.PORT || '8080' } }); if (result.status !== 0) process.exit(result.status ?? 1); }; run('node', ['./build.mjs']); run('node', ['--enable-source-maps', './dist/index.mjs']);\"",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.72",
    "@clerk/shared": "^4.36.0",
    "@swc/helpers": "^0.5.23",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pdfkit": "^0.17.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "openai": "^7.23.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "cross-env": "^10.0.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
