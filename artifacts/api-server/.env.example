# CampusMind AI runs on a local SQLite file by default.
CAMPUSMIND_SQLITE_PATH=./data/campusmind-demo.sqlite

# Used only to sign the local demo-role cookie.
SESSION_SECRET=replace-with-a-long-random-development-value

# Optional: Clerk can be enabled for real sign-in. The free local demo mode
# works without these values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=