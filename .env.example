# Root-level template for GitHub-safe configuration.
# Copy this file to .env and replace placeholder values before running locally or deploying.
# Never commit real secrets, API keys, or credentials.

# Frontend (Vite)
VITE_APP_NAME=CampusMind AI
VITE_API_BASE_URL=https://your-backend-domain.example.com
VITE_API_PROXY_TARGET=http://localhost:8080
PORT=5000
BASE_PATH=/

# Backend / API
NODE_ENV=development
PORT=8080
SESSION_SECRET=replace-with-a-long-random-secret
CAMPUSMIND_SQLITE_PATH=./artifacts/api-server/data/campusmind-demo.sqlite

# Optional authentication providers
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_real_value
CLERK_SECRET_KEY=sk_test_replace_with_real_value

# Optional AI / external service provider
OPENAI_API_KEY=sk-proj-replace-with-real-key
OPENAI_MODEL=gpt-4o-mini

# Database connection (if moved from SQLite in the future)
DATABASE_URL=postgresql://username:password@host:5432/campusmind
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campusmind
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password

# Production deployment defaults (set only in deployment environment)
APP_BASE_URL=https://your-frontend-domain.example.com
API_BASE_URL=https://your-backend-domain.example.com
CORS_ORIGIN=https://your-frontend-domain.example.com
