# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# secrets / credentials
auth/*.json
secrets/
credentials/
**/*secret*
**/*credential*

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# GitHub / AI tool metadata
.cursor/
.github/instructions/

# Replit
.cache/
.local/

# Local CampusMind demo database and caches
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
**/*.db
**/*.db-journal
artifacts/**/data/*.sqlite
artifacts/**/data/*.sqlite-shm
artifacts/**/data/*.sqlite-wal

# Build artifacts and logs
*.log
build/
out/
coverage/
